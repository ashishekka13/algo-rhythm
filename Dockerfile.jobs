# algo-rhythm jobs (Cloud Run Jobs): build the library from the originals in the bucket (algo_rhythm.pipeline).
#   songs: canonical MP3, Demucs vocals (CPU), analysis, import      details: Gemini song details, search vectors
#   art: song images
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends rubberband-cli libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# PyTorch for the CPU only (no CUDA: a tenth of the size)
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir demucs==4.1.0 julius
COPY pyproject.toml ./
COPY algo_rhythm ./algo_rhythm
COPY tools ./tools
RUN pip install --no-cache-dir . && useradd --create-home dj
USER dj
# the Demucs model is fetched once, here, not by every task
RUN python -c "from demucs.pretrained import get_model; get_model('htdemucs')"

ENV LIBRARY_DIR=/tmp/library PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "-m", "algo_rhythm.pipeline"]
CMD ["songs"]
