# Copy to .env (never commit .env). Every value is optional: with none set, algo-rhythm runs from local files.

# Database: unset = read the library's JSON files (dev). Cloud SQL via the Cloud SQL connector or proxy:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/algorhythm

# Audio and stems: unset = already on local disk under LIBRARY_DIR. In GCP, a bucket; files are cached locally.
# STORAGE_URL=gs://YOUR_BUCKET/library
LIBRARY_DIR=./library_100

# Gemini (GenAI gateway). Prefer Secret Manager in GCP; locally the key file ~/.config/song-matcher/gemini_key also works.
# GEMINI_API_KEY=
# vertex = Vertex AI express-mode key (billed); studio = an AI Studio key (generativelanguage.googleapis.com)
GEMINI_BACKEND=vertex
# Vertex regional endpoint instead of the global one (needs the project):
# VERTEX_LOCATION=asia-south1
# GOOGLE_CLOUD_PROJECT=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_CAP=200
GEMINI_EMBED_MODEL=gemini-embedding-001

HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# AI MC voice. MC_TTS = gemini (default: Gemini text-to-speech on the same Vertex AI key) | cloud | say (the Mac's voice).
MC_TTS=gemini
MC_VOICE=Aoede             # Gemini voice: Puck, Fenrir, Charon, Kore, Aoede, Zephyr, ...
# MC_STYLE="Say it like an energetic Bollywood wedding DJ hyping up the crowd, with an Indian accent: "
# MC_SAY_VOICE=Rishi       # Mac voice for MC_TTS=say or when Gemini fails: Rishi, Aman, Tara, Lekha (Hindi)
# Cloud Text-to-Speech (MC_TTS=cloud) needs a Google Cloud login, not an API key:
# MC_TTS_PROJECT=your-gcp-project   # uses Application Default Credentials, billed to this project
# MC_CLOUD_VOICE=en-IN-Wavenet-C
